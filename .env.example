# Backend (configure no painel do Dokploy; nunca commite o .env real)
DB_URL=jdbc:postgresql://localhost:5432/oficina
DB_USER=oficina
DB_PASSWORD=troque-esta-senha
# Só em desenvolvimento local, se o front rodar em outra porta
CORS_ORIGENS=
# Pasta dos uploads (no Dokploy: o caminho do volume montado)
UPLOADS_DIR=./uploads

# Acesso (Módulo 1)
# Segredo do token de sessão: mínimo 32 caracteres aleatórios
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
# true em produção (HTTPS); false só para desenvolvimento local sem HTTPS
COOKIE_SECURE=true
# Primeiro funcionário com acesso (criado só se ainda não existir nenhum)
ADMIN_NOME=Atendente
ADMIN_LOGIN=
ADMIN_SENHA=

# Cobrança online com o Asaas (opcional; veja docs/asaas.md). Sem a chave, o sistema funciona sem cobrança online.
# A chave começa com $aact_ e tem '$': no Dokploy use aspas simples. Padrão da URL = SANDBOX.
ASAAS_API_KEY=
ASAAS_URL=https://api-sandbox.asaas.com/v3
# Segredo diferente da chave, igual ao "token de autenticação" do webhook configurado no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
